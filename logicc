print(f"{'Process':<10}{'Event':<10}{'Type':<12}{'Timestamp':<10}")
print("-" * 60)

for process in [P1, P2, P3]:
    for event in process.events:
        event_id, event_type, timestamp = event
        print(
            f"{process.name:<10}"
            f"{event_id:<10}"
            f"{event_type:<12}"
            f"{timestamp:<10}"
        )


