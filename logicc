class Process:
    def __init__(self, name):
        self.name = name
        self.clock = 0
        self.events = []

    # Local Event function
    # clock increments by one
    def local_event(self, event_id):
        self.clock += 1
        self.events.append((event_id, "LOCAL", self.clock))

    # Send Message function
    #sender increments its clock before sending
    def send_message(self, receiver, message_id):
        self.clock += 1

        message = {
            "id": message_id,
            "sender": self.name,
            "receiver": receiver.name,
            "timestamp": self.clock
        }

        self.events.append((message_id, "SEND", self.clock))
        return message

    # Receive Message function
    # so if p1 is sending msg to p2, we take the max of p2's time and p1's timestamp
    def receive_message(self, message, event_id):
        received_timestamp = message["timestamp"]

        self.clock = max(self.clock, received_timestamp) + 1

        self.events.append((event_id, "RECEIVE", self.clock))


# ==================================================
# creating p1,p2 and p3 (three independent objects)
# ==================================================

P1 = Process("P1")
P2 = Process("P2")
P3 = Process("P3")


print("=" * 60)
print("             LAMPORT LOGICAL CLOCK")
print("=" * 60)
# initially all 3 r 0
print("\nInitial Logical Clocks:")
print("P1 =", P1.clock)
print("P2 =", P2.clock)
print("P3 =", P3.clock)

print("\nEvent Execution:")
print("-" * 60)


# ==================================================
# exxecuting the required events
# ==================================================

# 1. P1 performs local event E1
P1.local_event("E1") #p1 =1

# 2. P1 sends message M1 to P2
M1 = P1.send_message(P2, "M1") # p1 =2 and p2 = 0

# 3. P2 receives message M1
P2.receive_message(M1, "E3") # max(0,2)+1

# 4. P2 performs local event E4
P2.local_event("E4") # 3+1=4

# 5. P2 sends message M2 to P3
M2 = P2.send_message(P3, "M2")#p2 = 4+1=5

# 6. P1 performs local event E6
P1.local_event("E6") # p1 = 2+1 =3

# 7. P1 sends message M3 to P3
M3 = P1.send_message(P3, "M3") # 3+1=4

# 8. P3 receives message M2 from P2
P3.receive_message(M2, "E8") #5+1=6

# 9. P3 receives message M3 from P1
P3.receive_message(M3, "E9") # 6+1=7


